#!/bin/sh
# 커밋 메시지의 scope가 스테이징된 경로의 scope 라벨과 같은지 검사한다.
# prefix, 소문자 동사, 72자 등 나머지 형식은 글로벌 GIT.md 규칙이 담당한다.

. "$(dirname "$0")/../common/scope.sh"

reject() {
  echo "커밋 거부: $1" >&2
  exit 1
}

subject=$(head -n 1 "$1")
scope=$(printf '%s' "$subject" | sed -nE 's/^[a-z]+\(([^)]*)\)!?: .*/\1/p')

[ -n "$scope" ] || reject "scope가 없다. '{prefix}({scope}): {message}' 형식으로 써라. (받은 메시지: $subject)"

case "$scope" in
  guarded|unguarded|docs|root) ;;
  *) reject "'$scope'는 scope가 아니다. guarded, unguarded, docs, root 중 하나를 써라." ;;
esac

actual=$(staged_scopes)
[ -z "$actual" ] && exit 0

[ "$actual" = "$scope" ] || reject "메시지 scope는 '$scope'인데 스테이징된 경로의 scope는 '$(printf '%s' "$actual" | tr '\n' ' ')'이다. 메시지 scope를 경로에 맞춰라."
